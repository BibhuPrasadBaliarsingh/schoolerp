### School ERP Backend API Test
### Base URL for all requests
@baseUrl = http://localhost:5000/api
@token = YOUR_JWT_TOKEN_HERE

### ====================
### AUTHENTICATION ROUTES
### ====================

### Register a new user (Student)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "password123",
  "username": "john_student",
  "role": "student"
}

### Register Admin
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin123",
  "username": "admin_user",
  "role": "admin"
}

### Register Teacher
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "teacher@example.com",
  "password": "teacher123",
  "username": "teacher_user",
  "role": "teacher"
}

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin123"
}

### Get Current User (Protected)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### ====================
### USER ROUTES
### ====================

### Get all users (Admin only)
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

### Get all users by role (Admin only)
GET {{baseUrl}}/users?role=admin
Authorization: Bearer {{token}}

### Get specific user by ID (Protected)
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}

### Update user (Protected)
PATCH {{baseUrl}}/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "updated_username"
}

### Delete user (Admin only)
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}

### ====================
### FEE ROUTES
### ====================

### Get all fees (Protected)
GET {{baseUrl}}/fees
Authorization: Bearer {{token}}

### Get specific fee by ID (Protected)
GET {{baseUrl}}/fees/{{feeId}}
Authorization: Bearer {{token}}

### Create a new fee (Admin only)
POST {{baseUrl}}/fees
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "studentId": "{{studentId}}",
  "amount": 5000,
  "type": "tuition",
  "status": "pending",
  "dueDate": "2026-04-01T00:00:00Z"
}

### Update fee (Admin only)
PATCH {{baseUrl}}/fees/{{feeId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "paid"
}

### Delete fee (Admin only)
DELETE {{baseUrl}}/fees/{{feeId}}
Authorization: Bearer {{token}}

### ====================
### ASSIGNMENT ROUTES
### ====================

### Get all assignments (Protected)
GET {{baseUrl}}/assignments
Authorization: Bearer {{token}}

### Get assignments by class (Protected)
GET {{baseUrl}}/assignments?class=10A
Authorization: Bearer {{token}}

### Get assignments by teacher (Protected)
GET {{baseUrl}}/assignments?createdBy={{teacherId}}
Authorization: Bearer {{token}}

### Get specific assignment by ID (Protected)
GET {{baseUrl}}/assignments/{{assignmentId}}
Authorization: Bearer {{token}}

### Create a new assignment (Teacher/Admin only)
POST {{baseUrl}}/assignments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Mathematics Chapter 5 - Algebra",
  "description": "Solve all problems from section 5.1 to 5.5",
  "dueDate": "2026-03-15T23:59:59Z",
  "class": "10A",
  "subject": "Mathematics",
  "createdBy": "{{teacherId}}"
}

### Update assignment (Teacher/Admin only)
PATCH {{baseUrl}}/assignments/{{assignmentId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Updated Assignment Title",
  "dueDate": "2026-03-25T23:59:59Z"
}

### Delete assignment (Teacher/Admin only)
DELETE {{baseUrl}}/assignments/{{assignmentId}}
Authorization: Bearer {{token}}

### ====================
### BUS ROUTES
### ====================

### Get all buses (Protected)
GET {{baseUrl}}/buses
Authorization: Bearer {{token}}

### Get specific bus by ID (Protected)
GET {{baseUrl}}/buses/{{busId}}
Authorization: Bearer {{token}}

### Create a new bus (Admin only)
POST {{baseUrl}}/buses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "registrationNumber": "KL-01-AB-1234",
  "driverName": "Rajesh Kumar",
  "driverPhone": "+91-9876543210",
  "capacity": 50,
  "route": "Downtown - School Route A",
  "routeWaypoints": [
    {
      "latitude": 10.3520,
      "longitude": 76.5625,
      "name": "Downtown Terminal"
    },
    {
      "latitude": 10.3600,
      "longitude": 76.5700,
      "name": "Central Market"
    },
    {
      "latitude": 10.3680,
      "longitude": 76.5800,
      "name": "City School"
    }
  ],
  "status": "active",
  "gpsDeviceId": "GPS-001"
}

### Update bus info (Admin only)
PATCH {{baseUrl}}/buses/{{busId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "driverPhone": "+91-9876543220",
  "status": "inactive",
  "currentLocation": {
    "latitude": 10.3700,
    "longitude": 76.5750,
    "lastUpdated": "2026-02-26T12:30:00Z"
  }
}

### Delete bus (Admin only)
DELETE {{baseUrl}}/buses/{{busId}}
Authorization: Bearer {{token}}

### ====================
### STAFF ROUTES
### ====================

### Get all staff (Protected)
GET {{baseUrl}}/staff
Authorization: Bearer {{token}}

### Get staff by department (Protected)
GET {{baseUrl}}/staff?department=Teaching
Authorization: Bearer {{token}}

### Get staff by status (Protected)
GET {{baseUrl}}/staff?status=active
Authorization: Bearer {{token}}

### Get specific staff by ID (Protected)
GET {{baseUrl}}/staff/{{staffId}}
Authorization: Bearer {{token}}

### Create a new staff member (Admin only)
POST {{baseUrl}}/staff
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Dr. Ramesh Kumar",
  "email": "ramesh.kumar@school.com",
  "phone": "+91-9876543212",
  "position": "Mathematics Teacher",
  "department": "Teaching",
  "dateOfJoining": "2020-06-01T00:00:00Z",
  "salary": 45000,
  "status": "active"
}

### Update staff info (Admin only)
PATCH {{baseUrl}}/staff/{{staffId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "salary": 50000,
  "position": "Senior Mathematics Teacher",
  "email": "ramesh.kumar.updated@school.com"
}

### Delete staff member (Admin only)
DELETE {{baseUrl}}/staff/{{staffId}}
Authorization: Bearer {{token}}

### ====================
### INCOME/EXPENSE ROUTES
### ====================

### Get all income and expense records (Admin only)
GET {{baseUrl}}/income-expense
Authorization: Bearer {{token}}

### Get all income records (Admin only)
GET {{baseUrl}}/income-expense?type=income
Authorization: Bearer {{token}}

### Get all expense records (Admin only)
GET {{baseUrl}}/income-expense?type=expense
Authorization: Bearer {{token}}

### Get specific record by ID (Admin only)
GET {{baseUrl}}/income-expense/{{incomeExpenseId}}
Authorization: Bearer {{token}}

### Create income record - Fee collection (Admin only)
POST {{baseUrl}}/income-expense
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "type": "income",
  "category": "Fee Collection",
  "amount": 50000,
  "description": "Monthly fees collected from students",
  "date": "2026-02-26T00:00:00Z",
  "paymentMode": "online",
  "receiptNumber": "REC-2026-001",
  "createdBy": "{{adminId}}"
}

### Create expense record - Facility maintenance (Admin only)
POST {{baseUrl}}/income-expense
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "type": "expense",
  "category": "Maintenance",
  "amount": 15000,
  "description": "School building maintenance and repairs",
  "date": "2026-02-20T00:00:00Z",
  "paymentMode": "cheque",
  "receiptNumber": "PAY-2026-001",
  "createdBy": "{{adminId}}"
}

### Update income/expense record (Admin only)
PATCH {{baseUrl}}/income-expense/{{incomeExpenseId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 60000,
  "description": "Updated amount - Additional fees collected"
}

### Delete income/expense record (Admin only)
DELETE {{baseUrl}}/income-expense/{{incomeExpenseId}}
Authorization: Bearer {{token}}

### ====================
### NOTES ON USAGE
### ====================
# 1. First, register/login to get a JWT token
# 2. Copy the token from response and replace {{token}} variable at the top
# 3. All protected routes require: Authorization: Bearer {{token}}
#
# Replace the following variables with actual MongoDB ObjectIds from your database:
# {{userId}} - A valid User ID (e.g., from Create user response)
# {{teacherId}} - A valid User ID with role "teacher"
# {{studentId}} - A valid User ID with role "student"
# {{adminId}} - A valid User ID with role "admin"
# {{assignmentId}} - A valid Assignment ID
# {{busId}} - A valid Bus ID
# {{feeId}} - A valid Fee ID
# {{staffId}} - A valid Staff ID
# {{incomeExpenseId}} - A valid IncomeExpense ID

